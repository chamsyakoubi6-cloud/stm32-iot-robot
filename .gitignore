# ============================================================
#  Keil uVision / STM32 build artifacts
# ============================================================

# Build output directories
Objects/
Listings/

# Keil / Arm Compiler object & intermediate files
*.o
*.crf
*.d
*.dep
*.lnp
*.bak
*.htm
*.scvd

# Compiled / flashable images
*.axf
*.hex
*.bin

# Keil per-user GUI layout (machine specific)
*.uvguix.*

# Debug configuration (regenerated by the IDE)
DebugConfig/

# CMSIS Run-Time Environment (regenerated by Keil from the device pack)
RTE/

# ============================================================
#  OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.tmp
